# ─── AgentAssistant Configuration ───────────────────────────────────
# Copy this to .env and fill in your keys.

# Required: DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Thinking: off | low | high | max  (lower = faster / cheaper)
REASONING_EFFORT=low

# Optional: Web search (Tavily fallback)
# TAVILY_API_KEY=tvly-xxxxx

# Optional: Storage paths (defaults to ~/AgentAssistant)
# DATA_DIR=C:\Users\hp\AgentAssistant
# NOTES_DIR=

# Optional: Voice (J20)
# STT_MODEL=small
# STT_DEVICE=cpu
# TTS_VOICE=
